rules_version = '2';

// Firebase Storage Security Rules for KEREK
//   chat/{conversationId}/{messageId}/{fileName}  — files shared in a conversation
//   requests/{requestId}/{fileName}               — photos, videos and voice notes of a request
//   providers/{uid}/portfolio/{slot}              — a master's work photos (slots p0 … p7)
//
// Only an explicit list of content types is accepted. Anything else (HTML, SVG, scripts,
// archives, executables) is refused, so uploaded files can't be used to host pages or malware.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function conversationDoc(conversationId) {
      return firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data;
    }

    function requestDoc(requestId) {
      return firestore.get(/databases/(default)/documents/requests/$(requestId)).data;
    }

    // The customer, or the provider of the conversation (providerUserId, or providerId for older documents)
    function isConversationParticipant(conversationId) {
      let c = conversationDoc(conversationId);
      return isSignedIn()
        && (c.get('customerId', '') == request.auth.uid
            || c.get('providerUserId', '') == request.auth.uid
            || c.get('providerId', '') == request.auth.uid);
    }

    function isImage(maxBytes) {
      return request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size <= maxBytes;
    }

    // Chat files: images, or PDF documents such as estimates and invoices
    match /chat/{conversationId}/{messageId}/{fileName} {
      allow read: if isConversationParticipant(conversationId);

      // resource is the file already stored at this path: uploads never replace an existing file.
      // Files can be added only while the job is active.
      allow create: if resource == null
                    && isConversationParticipant(conversationId)
                    && requestDoc(conversationDoc(conversationId).get('requestId', '-')).get('status', '') in ['PROVIDER_SELECTED', 'ACCEPTED', 'IN_PROGRESS']
                    && request.resource.size > 0
                    && (isImage(10 * 1024 * 1024)
                        || (request.resource.contentType == 'application/pdf' && request.resource.size <= 20 * 1024 * 1024));

      // Files are kept unchanged for the conversation record
      allow update, delete: if false;
    }

    // Same audience as the request document in firestore.rules: the customer, providers in the
    // request's city, and the provider whose offer was selected.
    function canReadRequestFiles(requestId) {
      let r = requestDoc(requestId);
      return isSignedIn() && (
        r.get('customerId', '') == request.auth.uid
        || (firestore.exists(/databases/(default)/documents/providers/$(request.auth.uid))
            && r.get('cityId', '') != ''
            && r.get('status', '') in ['OPEN', 'NEW', 'MATCHING', 'OFFERS_RECEIVED']
            && firestore.get(/databases/(default)/documents/providers/$(request.auth.uid)).data.get('cityId', '') == r.get('cityId', '')
            && firestore.get(/databases/(default)/documents/providers/$(request.auth.uid)).data.get('blocked', false) != true)
        || (r.get('selectedOfferId', '') != ''
            && firestore.get(/databases/(default)/documents/offers/$(r.get('selectedOfferId', ''))).data.get('providerUserId', '') == request.auth.uid)
      );
    }

    // Uploads go to a request that already exists and belongs to the uploader. The app creates the
    // request first and attaches the files afterwards, so nobody can claim another request's folder.
    function isRequestOwner(requestId) {
      return isSignedIn() && requestDoc(requestId).get('customerId', '') == request.auth.uid;
    }

    // Files can be added while the request is still open
    function isOpenRequest(requestId) {
      return requestDoc(requestId).get('status', '') in ['OPEN', 'NEW', 'MATCHING', 'OFFERS_RECEIVED'];
    }

    match /requests/{requestId}/{fileName} {
      allow read: if canReadRequestFiles(requestId);

      // resource is the file already stored at this path: uploads never replace an existing file
      // At most 15 files per request: names are fixed slots att0 … att14
      allow create: if resource == null
                    && fileName.matches('att(1[0-4]|[0-9])')
                    && isRequestOwner(requestId)
                    && isOpenRequest(requestId)
                    && request.resource.size > 0
                    && (isImage(10 * 1024 * 1024)
                        || (request.resource.contentType.matches('video/(mp4|webm|quicktime)') && request.resource.size <= 50 * 1024 * 1024)
                        || (request.resource.contentType.matches('audio/(mpeg|mp4|wav|webm|ogg|x-m4a|aac)(;.*)?') && request.resource.size <= 20 * 1024 * 1024));

      // Account deletion: the customer removes their own request files
      allow delete: if isRequestOwner(requestId);
      allow update: if false;
    }

    // A master's work photos: shown with the profile (to phone-verified accounts, like the profile
    // itself); only the master adds, replaces or removes them
    match /providers/{uid}/portfolio/{slot} {
      allow read: if isSignedIn() && ('phone_number' in request.auth.token);
      allow create, update: if isSignedIn()
                            && request.auth.uid == uid
                            && ('phone_number' in request.auth.token)
                            && slot.matches('p[0-7]')
                            && request.resource.size > 0
                            && isImage(5 * 1024 * 1024);
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Deny all other storage access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
