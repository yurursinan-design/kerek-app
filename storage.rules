rules_version = '2';

// Firebase Storage Security Rules for KEREK
// Scope: Isolated per conversation under chat/{conversationId}/{messageId}/{fileName}
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // Helper: Validates if the authenticated user is a participant of the conversation in Firestore
    function isConversationParticipant(conversationId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/conversations/$(conversationId))
        && (
          firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.customerId == request.auth.uid
          || firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.providerUserId == request.auth.uid
          || firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.providerId == request.auth.uid
        );
    }

    // Chat attachments storage isolation
    match /chat/{conversationId}/{messageId}/{fileName} {
      // 1. Read: Only authenticated conversation participants can read files
      allow read: if isConversationParticipant(conversationId);

      // 2. Write (Upload):
      // - Must be an authenticated participant
      // - Max image size 10MB, general file size 20MB
      // - Prohibit executable / dangerous content types
      allow create: if isConversationParticipant(conversationId)
                    && request.resource.size > 0
                    && request.resource.size <= 20 * 1024 * 1024
                    && (
                      (request.resource.contentType.matches('image/.*') && request.resource.size <= 10 * 1024 * 1024)
                      || (request.resource.contentType.matches('application/.*') || request.resource.contentType.matches('text/.*'))
                    )
                    && !request.resource.contentType.matches('.*executable.*')
                    && !request.resource.contentType.matches('.*x-sh.*')
                    && !request.resource.contentType.matches('.*x-msdos-program.*');

      // 3. Updates and deletions prohibited for audit integrity
      allow update: if false;
      allow delete: if false;
    }

    // Helper: Validates if the authenticated user has access to read/write request attachments
    function canAccessRequest(requestId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/requests/$(requestId))
        && (
          firestore.get(/databases/(default)/documents/requests/$(requestId)).data.customerId == request.auth.uid
          || (
            firestore.exists(/databases/(default)/documents/providers/$(request.auth.uid))
            && firestore.get(/databases/(default)/documents/providers/$(request.auth.uid)).data.cityId == firestore.get(/databases/(default)/documents/requests/$(requestId)).data.cityId
            && firestore.get(/databases/(default)/documents/providers/$(request.auth.uid)).data.categoryId == firestore.get(/databases/(default)/documents/requests/$(requestId)).data.categoryId
          )
        );
    }

    function isRequestOwner(requestId) {
      return isSignedIn()
        && (
          !firestore.exists(/databases/(default)/documents/requests/$(requestId))
          || firestore.get(/databases/(default)/documents/requests/$(requestId)).data.customerId == request.auth.uid
        );
    }

    // Request 2.0 media attachments storage isolation: requests/{requestId}/{fileName}
    match /requests/{requestId}/{fileName} {
      // 1. Read: Owner customer or authorized category/city matching providers can read
      allow read: if canAccessRequest(requestId);

      // 2. Upload: Only request owner can upload attachments
      // - Max image 10MB, video 50MB, audio 20MB
      // - Disallow executable and script types
      allow create: if isRequestOwner(requestId)
                    && request.resource.size > 0
                    && (
                      (request.resource.contentType.matches('image/.*') && request.resource.size <= 10 * 1024 * 1024)
                      || (request.resource.contentType.matches('video/.*') && request.resource.size <= 50 * 1024 * 1024)
                      || (request.resource.contentType.matches('audio/.*') && request.resource.size <= 20 * 1024 * 1024)
                    )
                    && !request.resource.contentType.matches('.*executable.*')
                    && !request.resource.contentType.matches('.*x-sh.*')
                    && !request.resource.contentType.matches('.*x-msdos-program.*');

      allow update: if false;
      allow delete: if false;
    }

    // Deny all other storage access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
