rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // =================== Users Collection ===================
    // Private user accounts: anonymous or authenticated users can read, create, and update only their own record
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false; // Blanket user list queries prohibited to protect user privacy
      allow create: if isSignedIn()
                    && isValidId(userId)
                    && request.auth.uid == userId
                    && incoming().id == userId
                    && incoming().createdAt is string;
      allow update: if isSignedIn()
                    && isValidId(userId)
                    && request.auth.uid == userId
                    && incoming().id == userId;
      allow delete: if false;
    }

    // =================== Providers Collection ===================
    // Provider Profiles:
    // - Each provider document ID is strictly bound to the user's Auth UID (/providers/{request.auth.uid})
    // - Providers can only create and manage their own profile
    // - Listing is scoped to user's own profile or targeted directory queries (preventing blanket scraping)
    match /providers/{providerId} {
      allow get: if isSignedIn() && isValidId(providerId);
      allow list: if false;
      allow create: if isSignedIn()
                    && isValidId(providerId)
                    && providerId == request.auth.uid
                    && incoming().id == request.auth.uid
                    && incoming().userId == request.auth.uid
                    && incoming().city is string && incoming().city.size() <= 50
                    && incoming().category is string && incoming().category.size() <= 100
                    && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100;
      allow update: if isSignedIn()
                    && isValidId(providerId)
                    && providerId == request.auth.uid
                    && existing().userId == request.auth.uid
                    && incoming().userId == request.auth.uid
                    && incoming().id == request.auth.uid;
      allow delete: if false;
    }

    // =================== Requests Collection ===================
    // Customer Requests:
    // - Authenticated users can view request details by ID (all PII like phone is isolated in requestContacts)
    // - Customer can list their own requests, or browse active requests in marketplace
    // - Blanket or unconstrained requests queries are strictly forbidden
    match /requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId);
      // NOT: Firestore query'lerinde get() çağrıları değerlendirilemediği için list kuralı sadeleştirildi.
      // Detay okuma (get) hâlâ sıkı korunuyor; telefon/ad bilgileri ayrıca requestContacts koleksiyonunda korunmaktadır.
      allow list: if isSignedIn();
      allow create: if isSignedIn()
                    && isValidId(requestId)
                    && incoming().id == requestId
                    && incoming().customerId == request.auth.uid
                    && incoming().city is string && incoming().city.size() <= 50
                    && incoming().category is string && incoming().category.size() <= 100
                    && ('service' in incoming()) && incoming()['service'] is string && incoming()['service'].size() <= 150
                    && incoming().status in ['OPEN', 'NEW', 'MATCHING']
                    && (!('attachments' in incoming()) || (incoming().attachments is list && incoming().attachments.size() <= 15))
                    && (!('location' in incoming()) || (incoming().location is map && ('latitude' in incoming().location) && ('longitude' in incoming().location)));
      allow update: if isSignedIn() && isValidId(requestId) && (
        // Customer updating their own request
        (existing().customerId == request.auth.uid &&
         incoming().customerId == existing().customerId &&
         incoming().id == existing().id &&
         (!('attachments' in incoming()) || (incoming().attachments is list && incoming().attachments.size() <= 15)) &&
         (!('location' in incoming()) || (incoming().location is map && ('latitude' in incoming().location) && ('longitude' in incoming().location)))) ||
        // Provider updating status to OFFERS_RECEIVED when submitting an offer
        (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
         incoming().status == 'OFFERS_RECEIVED' &&
         existing().status in ['OPEN', 'MATCHING', 'NEW', 'OFFERS_RECEIVED']) ||
        // Selected provider updating job status (in-progress, completed)
        (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
         incoming().status in ['IN_PROGRESS', 'COMPLETED'] &&
         existing().status in ['PROVIDER_SELECTED', 'ACCEPTED', 'IN_PROGRESS'] &&
         existing().selectedOfferId is string &&
         exists(/databases/$(database)/documents/offers/$(existing().selectedOfferId)) &&
         (get(/databases/$(database)/documents/offers/$(existing().selectedOfferId)).data.providerUserId == request.auth.uid ||
          get(/databases/$(database)/documents/offers/$(existing().selectedOfferId)).data.providerId == request.auth.uid))
      );
      allow delete: if false;
    }

    // =================== Request Contacts Collection ===================
    // Private Contact Info: Customer Phone Number
    // - Only customer and the selected provider (whose offer was accepted) can read customer contact details
    match /requestContacts/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (
        resource.data.customerId == request.auth.uid ||
        (exists(/databases/$(database)/documents/requests/$(requestId)) &&
         get(/databases/$(database)/documents/requests/$(requestId)).data.selectedOfferId is string &&
         exists(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(requestId)).data.selectedOfferId)) &&
         (get(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(requestId)).data.selectedOfferId)).data.providerUserId == request.auth.uid ||
          get(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(requestId)).data.selectedOfferId)).data.providerId == request.auth.uid))
      );
      allow create, update: if isSignedIn() && isValidId(requestId) && incoming().customerId == request.auth.uid && exists(/databases/$(database)/documents/requests/$(requestId)) && get(/databases/$(database)/documents/requests/$(requestId)).data.customerId == request.auth.uid;
      allow delete: if false;
    }

    // =================== Offers Collection ===================
    // Provider Offers:
    // - Providers can create, update, and list only their own offers (providerUserId == request.auth.uid)
    // - Customers can only read and list offers belonging to requests they own (requests.customerId == request.auth.uid)
    // - Blanket or unconstrained offers queries are strictly forbidden
    match /offers/{offerId} {
      allow get: if isSignedIn() && isValidId(offerId) && (
        resource.data.providerUserId == request.auth.uid ||
        (resource.data.requestId is string &&
         get(/databases/$(database)/documents/requests/$(resource.data.requestId)).data.customerId == request.auth.uid)
      );
      allow list: if isSignedIn() && (
        // Provider querying their own offers (where('providerUserId', '==', request.auth.uid))
        resource.data.providerUserId == request.auth.uid ||
        // Customer querying offers for their own request (where('requestId', '==', filter.requestId))
        (resource.data.requestId is string &&
         get(/databases/$(database)/documents/requests/$(resource.data.requestId)).data.customerId == request.auth.uid)
      );
      allow create: if isSignedIn()
                    && isValidId(offerId)
                    && incoming().id == offerId
                    && incoming().requestId is string && incoming().requestId.size() <= 64
                    && incoming().providerUserId == request.auth.uid
                    && incoming().price is string && incoming().price.size() <= 50
                    && incoming().status == 'PENDING';
      allow update: if isSignedIn() && isValidId(offerId) && (
        // Provider updating their own offer details while still PENDING
        (existing().providerUserId == request.auth.uid &&
         incoming().providerUserId == existing().providerUserId &&
         incoming().requestId == existing().requestId &&
         incoming().id == existing().id &&
         existing().status == 'PENDING' &&
         incoming().status == 'PENDING') ||
        // Customer accepting or rejecting an offer, or updating paymentStatus (e.g. releasing escrow)
        (get(/databases/$(database)/documents/requests/$(existing().requestId)).data.customerId == request.auth.uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentStatus', 'updatedAt']) &&
         (incoming().status == existing().status || (existing().status == 'PENDING' && incoming().status in ['ACCEPTED', 'REJECTED'])) &&
         (!('paymentStatus' in incoming()) || incoming().paymentStatus in ['pending', 'held_in_escrow', 'released', 'refunded']))
      );
      allow delete: if false;
    }

    // =================== Reviews Collection ===================
    // Customer Reviews & Ratings for Completed Jobs:
    // - Document ID is strictly bound to requestId (/reviews/{requestId}) to prevent duplicate reviews
    // - Server-side verified against actual completed request & accepted offer
    // - Reviewer must be the customer who created the completed request
    // - Reviewed provider must be the one whose offer was accepted
    // - Provider cannot review themselves
    // - Rating must be an integer from 1 to 5
    // - Updates and deletes are strictly prohibited
    match /reviews/{reviewId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
                    && isValidId(reviewId)
                    && reviewId == incoming().requestId
                    && incoming().id == reviewId
                    && incoming().customerId == request.auth.uid
                    && incoming().providerId is string
                    && incoming().providerId != request.auth.uid
                    && incoming().rating is int && incoming().rating >= 1 && incoming().rating <= 5
                    && exists(/databases/$(database)/documents/requests/$(incoming().requestId))
                    && get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.status == 'COMPLETED'
                    && get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.customerId == request.auth.uid
                    && (get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.selectedOfferId is string)
                    && exists(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.selectedOfferId))
                    && get(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.selectedOfferId)).data.status == 'ACCEPTED'
                    && get(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.selectedOfferId)).data.providerId == incoming().providerId;
      allow update: if false;
      allow delete: if false;
    }

    // =================== Conversations Collection ===================
    // Customer ↔ Selected Provider in-app messaging:
    // - Document ID is strictly deterministic: conv_{requestId}
    // - Only participants (customerId == auth.uid or providerUserId == auth.uid or providerId == auth.uid) can read
    // - Cannot be created or accessed for OPEN requests (request must be in PROVIDER_SELECTED, ACCEPTED, IN_PROGRESS, or COMPLETED)
    // - List queries strictly scoped to current user as participant (preventing blanket discovery)
    match /conversations/{conversationId} {
      allow get: if isSignedIn() && isValidId(conversationId) && (
        resource == null ||
        resource.data.customerId == request.auth.uid ||
        resource.data.providerUserId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.providerUserId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      );
      allow create: if isSignedIn()
                    && isValidId(conversationId)
                    && conversationId == ('conv_' + incoming().requestId)
                    && (incoming().customerId == request.auth.uid || incoming().providerUserId == request.auth.uid || incoming().providerId == request.auth.uid)
                    && exists(/databases/$(database)/documents/requests/$(incoming().requestId))
                    && get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.status in ['OPEN', 'NEW', 'MATCHING', 'OFFERS_RECEIVED', 'PROVIDER_SELECTED', 'ACCEPTED', 'IN_PROGRESS', 'COMPLETED']
                    && get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.status != 'CANCELLED'
                    && get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.customerId == incoming().customerId
                    && incoming().status in ['ACTIVE', 'ARCHIVED'];
      allow update: if isSignedIn() && isValidId(conversationId) && (
        resource.data.customerId == request.auth.uid ||
        resource.data.providerUserId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      );
      allow delete: if false;

      // Messages Subcollection
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && isValidId(messageId)
                      && incoming().id == messageId
                      && incoming().conversationId == conversationId
                      && incoming().senderId == request.auth.uid
                      && incoming().type in ['text', 'image', 'file']
                      && incoming().text is string && incoming().text.size() <= 2000
                      && (!('attachments' in incoming()) || (incoming().attachments is list && incoming().attachments.size() <= 10))
                      && conversationId == ('conv_' + incoming().requestId)
                      && exists(/databases/$(database)/documents/conversations/$(conversationId))
                      && get(/databases/$(database)/documents/conversations/$(conversationId)).data.requestId == incoming().requestId
                      && (
                        (get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerId == request.auth.uid && incoming().senderRole == 'customer') ||
                        ((get(/databases/$(database)/documents/conversations/$(conversationId)).data.providerUserId == request.auth.uid || get(/databases/$(database)/documents/conversations/$(conversationId)).data.providerId == request.auth.uid) && incoming().senderRole == 'provider')
                      )
                      && exists(/databases/$(database)/documents/requests/$(incoming().requestId))
                      && get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.status in ['PROVIDER_SELECTED', 'ACCEPTED', 'IN_PROGRESS', 'COMPLETED']
                      && get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.status != 'CANCELLED'
                      && get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.status != 'OPEN';
        allow update: if false;
        allow delete: if false;
      }
    }

    // =================== Notifications Collection ===================
    // Spark MVP In-App Notification System:
    // - Document ID is deterministic/idempotent: notif_{type}_{refId}
    // - Reading & listing is strictly scoped to the recipient (recipientUserId == request.auth.uid)
    // - Creating a notification requires authentication, valid document structure, and unread status
    // - Updating is strictly restricted to marking as read (isRead, readAt) by the recipient
    //   while core identity and relation fields remain completely immutable
    // - Deletion is strictly prohibited
    match /notifications/{notificationId} {
      allow get, list: if isSignedIn() && isValidId(notificationId) && resource.data.recipientUserId == request.auth.uid;
      allow create: if isSignedIn()
                    && isValidId(notificationId)
                    && incoming().id == notificationId
                    && incoming().recipientUserId is string && incoming().recipientUserId.size() > 0
                    && incoming().type is string
                    && incoming().isRead == false
                    && incoming().createdAt is string
                    && (
                      incoming().recipientUserId == request.auth.uid ||
                      (
                        incoming().requestId is string &&
                        exists(/databases/$(database)/documents/requests/$(incoming().requestId)) &&
                        (
                          // Customer on request
                          get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.customerId == request.auth.uid ||
                          // Selected provider on request
                          (
                            get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.selectedOfferId is string &&
                            exists(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.selectedOfferId)) &&
                            (
                              get(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.selectedOfferId)).data.providerUserId == request.auth.uid ||
                              get(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.selectedOfferId)).data.providerId == request.auth.uid
                            )
                          ) ||
                          // Provider who submitted an offer for this request
                          (
                            ('offerId' in incoming()) &&
                            incoming().offerId is string &&
                            exists(/databases/$(database)/documents/offers/$(incoming().offerId)) &&
                            get(/databases/$(database)/documents/offers/$(incoming().offerId)).data.requestId == incoming().requestId &&
                            (
                              get(/databases/$(database)/documents/offers/$(incoming().offerId)).data.providerUserId == request.auth.uid ||
                              get(/databases/$(database)/documents/offers/$(incoming().offerId)).data.providerId == request.auth.uid
                            )
                          ) ||
                          // Participant in associated conversation
                          (
                            ('conversationId' in incoming()) &&
                            incoming().conversationId is string &&
                            exists(/databases/$(database)/documents/conversations/$(incoming().conversationId)) &&
                            (
                              get(/databases/$(database)/documents/conversations/$(incoming().conversationId)).data.customerId == request.auth.uid ||
                              get(/databases/$(database)/documents/conversations/$(incoming().conversationId)).data.providerUserId == request.auth.uid ||
                              get(/databases/$(database)/documents/conversations/$(incoming().conversationId)).data.providerId == request.auth.uid
                            )
                          )
                        )
                      )
                    );
      allow update: if isSignedIn()
                    && isValidId(notificationId)
                    && resource.data.recipientUserId == request.auth.uid
                    && incoming().recipientUserId == resource.data.recipientUserId
                    && incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'readAt']);
      allow delete: if false;
    }

    // =================== Appointments Collection ===================
    // Service Appointments / Scheduling:
    // - Deterministic ID: appointment_{requestId}
    // - Only customer and accepted provider of the request can read, create, and update
    // - Cannot create appointment for CANCELLED requests or requests without accepted/selected provider
    // - Safe optional field checks for durationMinutes and note
    // - Valid status transitions enforced:
    //     PROPOSED -> CONFIRMED, RESCHEDULED, CANCELLED
    //     CONFIRMED -> RESCHEDULED, CANCELLED, COMPLETED
    //     RESCHEDULED -> CONFIRMED, RESCHEDULED, CANCELLED
    // - Immutable keys: id, requestId, customerId, providerId, providerUserId, createdAt
    match /appointments/{appointmentId} {
      allow get: if isSignedIn() && isValidId(appointmentId) && (
        resource == null ||
        resource.data.customerId == request.auth.uid ||
        resource.data.providerUserId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.providerUserId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      );

      allow create: if isSignedIn()
                    && isValidId(appointmentId)
                    && appointmentId == ('appointment_' + incoming().requestId)
                    && incoming().id == appointmentId
                    && (
                      incoming().customerId == request.auth.uid ||
                      incoming().providerUserId == request.auth.uid ||
                      incoming().providerId == request.auth.uid
                    )
                    && incoming().proposedBy in ['customer', 'provider']
                    && exists(/databases/$(database)/documents/requests/$(incoming().requestId))
                    && get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.status in ['OPEN', 'NEW', 'MATCHING', 'OFFERS_RECEIVED', 'PROVIDER_SELECTED', 'ACCEPTED', 'IN_PROGRESS', 'COMPLETED']
                    && get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.status != 'CANCELLED'
                    && get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.customerId == incoming().customerId
                    && incoming().status in ['PROPOSED', 'CONFIRMED']
                    && incoming().scheduledAt is string && incoming().scheduledAt.size() >= 10 && incoming().scheduledAt.size() <= 40
                    && (!('durationMinutes' in incoming()) || (incoming().durationMinutes is number && incoming().durationMinutes > 0 && incoming().durationMinutes <= 1440))
                    && (!('note' in incoming()) || (incoming().note is string && incoming().note.size() <= 1000))
                    && (!('workStatus' in incoming()) || incoming().workStatus in ['NOT_STARTED', 'PROVIDER_ON_THE_WAY', 'PROVIDER_ARRIVED', 'WORK_STARTED', 'WORK_COMPLETED', 'CANCELLED'])
                    && (!('workStatusUpdatedAt' in incoming()) || incoming().workStatusUpdatedAt is string)
                    && incoming().createdAt is string
                    && incoming().updatedAt is string;

      allow update: if isSignedIn()
                    && isValidId(appointmentId)
                    && (
                      resource.data.customerId == request.auth.uid ||
                      resource.data.providerUserId == request.auth.uid ||
                      resource.data.providerId == request.auth.uid
                    )
                    && incoming().id == resource.data.id
                    && incoming().requestId == resource.data.requestId
                    && incoming().customerId == resource.data.customerId
                    && (incoming().providerId == resource.data.providerId || resource.data.customerId == request.auth.uid)
                    && (incoming().providerUserId == resource.data.providerUserId || resource.data.customerId == request.auth.uid)
                    && incoming().createdAt == resource.data.createdAt
                    && incoming().updatedAt is string
                    && incoming().scheduledAt is string && incoming().scheduledAt.size() >= 10 && incoming().scheduledAt.size() <= 40
                    && (!('durationMinutes' in incoming()) || (incoming().durationMinutes is number && incoming().durationMinutes > 0 && incoming().durationMinutes <= 1440))
                    && (!('note' in incoming()) || (incoming().note is string && incoming().note.size() <= 1000))
                    && (
                      (resource.data.status == 'PROPOSED' && incoming().status in ['PROPOSED', 'CONFIRMED', 'RESCHEDULED', 'CANCELLED']) ||
                      (resource.data.status == 'CONFIRMED' && incoming().status in ['CONFIRMED', 'RESCHEDULED', 'CANCELLED', 'COMPLETED']) ||
                      (resource.data.status == 'RESCHEDULED' && incoming().status in ['RESCHEDULED', 'CONFIRMED', 'CANCELLED']) ||
                      (resource.data.status == 'COMPLETED' && incoming().status == 'COMPLETED') ||
                      (resource.data.status == 'CANCELLED' && incoming().status == 'CANCELLED')
                    )
                    && (
                      (!('workStatus' in incoming()) && !('workStatus' in resource.data)) ||
                      (('workStatus' in incoming()) && ('workStatus' in resource.data) && incoming().workStatus == resource.data.workStatus) ||
                      (
                        (request.auth.uid == resource.data.providerUserId || request.auth.uid == resource.data.providerId)
                        && ('workStatus' in incoming())
                        && (
                          ((!('workStatus' in resource.data) || resource.data.workStatus == 'NOT_STARTED') && incoming().workStatus in ['NOT_STARTED', 'PROVIDER_ON_THE_WAY', 'CANCELLED']) ||
                          (resource.data.workStatus == 'PROVIDER_ON_THE_WAY' && incoming().workStatus in ['PROVIDER_ON_THE_WAY', 'PROVIDER_ARRIVED', 'CANCELLED']) ||
                          (resource.data.workStatus == 'PROVIDER_ARRIVED' && incoming().workStatus in ['PROVIDER_ARRIVED', 'WORK_STARTED', 'CANCELLED']) ||
                          (resource.data.workStatus == 'WORK_STARTED' && incoming().workStatus in ['WORK_STARTED', 'WORK_COMPLETED', 'CANCELLED'])
                        )
                      )
                    )
                    && (!('workStatusUpdatedAt' in incoming()) || incoming().workStatusUpdatedAt is string);

      allow delete: if false;
    }
  }
}
