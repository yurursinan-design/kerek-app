rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // Publishing (requests, offers, provider profiles) needs a phone-verified account (SMS login).
    // Anonymous accounts can still browse and use the AI analysis.
    function hasVerifiedPhone() {
      return isSignedIn() && ('phone_number' in request.auth.token) && request.auth.token.phone_number is string;
    }

    // Optional string field: absent, or a string of at most n characters
    function strMax(m, k, n) {
      return !(k in m) || (m[k] is string && m[k].size() <= n);
    }

    // Trust badges are not self-assignable: absent or false only
    function falseOrAbsent(m, k) {
      return !(k in m) || m[k] == false;
    }

    function noTrustBadges(m) {
      return falseOrAbsent(m, 'verified') && falseOrAbsent(m, 'iinVerified') && falseOrAbsent(m, 'hasCertificate');
    }

    function requestFieldLimits(m) {
      return strMax(m, 'requestText', 5000) && strMax(m, 'description', 5000)
        && strMax(m, 'customerName', 100) && strMax(m, 'budget', 100)
        && strMax(m, 'date', 100) && strMax(m, 'urgency', 20)
        && strMax(m, 'cityId', 64) && strMax(m, 'categoryId', 64) && strMax(m, 'serviceId', 64);
    }

    function offerFieldLimits(m) {
      return strMax(m, 'message', 2000) && strMax(m, 'availability', 300)
        && strMax(m, 'providerName', 100) && strMax(m, 'providerPhone', 30)
        && strMax(m, 'providerWhatsapp', 30) && strMax(m, 'priceType', 20);
    }

    function providerFieldLimits(m) {
      return strMax(m, 'phone', 30) && strMax(m, 'whatsapp', 30)
        && strMax(m, 'district', 100) && strMax(m, 'services', 1000)
        && strMax(m, 'priceRange', 100) && strMax(m, 'workingHours', 100)
        && strMax(m, 'description', 5000) && strMax(m, 'availability', 300)
        && strMax(m, 'tradeLicense', 100) && strMax(m, 'cityId', 64) && strMax(m, 'categoryId', 64);
    }

    // =================== Users Collection ===================
    // Private user accounts: anonymous or authenticated users can read, create, and update only their own record
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false; // Blanket user list queries prohibited to protect user privacy
      allow create: if isSignedIn()
                    && isValidId(userId)
                    && request.auth.uid == userId
                    && incoming().id == userId
                    && incoming().createdAt is string
                    && strMax(incoming(), 'name', 100) && strMax(incoming(), 'phone', 30);
      allow update: if isSignedIn()
                    && isValidId(userId)
                    && request.auth.uid == userId
                    && incoming().id == userId
                    && strMax(incoming(), 'name', 100) && strMax(incoming(), 'phone', 30);
      // Account deletion ("delete my account")
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // =================== Providers Collection ===================
    // Provider Profiles:
    // - Each provider document ID is strictly bound to the user's Auth UID (/providers/{request.auth.uid})
    // - Providers can only create and manage their own profile
    // - Listing is scoped to user's own profile or targeted directory queries (preventing blanket scraping)
    match /providers/{providerId} {
      allow get: if isSignedIn() && isValidId(providerId);
      allow list: if false;
      allow create: if hasVerifiedPhone()
                    && isValidId(providerId)
                    && providerId == request.auth.uid
                    && incoming().id == request.auth.uid
                    && incoming().userId == request.auth.uid
                    && incoming().city is string && incoming().city.size() <= 50
                    && incoming().category is string && incoming().category.size() <= 100
                    && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100
                    && noTrustBadges(incoming())
                    && providerFieldLimits(incoming());
      allow update: if hasVerifiedPhone()
                    && isValidId(providerId)
                    && providerId == request.auth.uid
                    && existing().userId == request.auth.uid
                    && incoming().userId == request.auth.uid
                    && incoming().id == request.auth.uid
                    && strMax(incoming(), 'name', 100) && strMax(incoming(), 'city', 50) && strMax(incoming(), 'category', 100)
                    && noTrustBadges(incoming())
                    && providerFieldLimits(incoming());
      // Account deletion: a provider can remove their own profile
      allow delete: if isSignedIn() && isValidId(providerId) && providerId == request.auth.uid;
    }

    // =================== Requests Collection ===================
    // Customer Requests:
    // - Authenticated users can view request details by ID (all PII like phone is isolated in requestContacts)
    // - Customer can list their own requests, or browse active requests in marketplace
    // - Blanket or unconstrained requests queries are strictly forbidden
    // A provider sees requests from their own city (the city on their provider profile)
    function isProviderInCityOf(r) {
      return exists(/databases/$(database)/documents/providers/$(request.auth.uid))
        && ('cityId' in r) && r.cityId is string
        && get(/databases/$(database)/documents/providers/$(request.auth.uid)).data.get('cityId', '') == r.cityId;
    }

    // The provider whose offer was selected keeps access to the request they work on
    function isSelectedProviderOf(r) {
      return ('selectedOfferId' in r) && r.selectedOfferId is string && r.selectedOfferId.size() > 0
        && exists(/databases/$(database)/documents/offers/$(r.selectedOfferId))
        && (get(/databases/$(database)/documents/offers/$(r.selectedOfferId)).data.get('providerUserId', '') == request.auth.uid
            || get(/databases/$(database)/documents/offers/$(r.selectedOfferId)).data.get('providerId', '') == request.auth.uid);
    }

    match /requests/{requestId} {
      // Requests are not public: only the customer, providers in the same city and the selected
      // provider can read them. Provider queries filter by cityId, which this rule can verify.
      allow get: if isSignedIn() && isValidId(requestId) && (
        resource == null ||
        resource.data.customerId == request.auth.uid ||
        isProviderInCityOf(resource.data) ||
        isSelectedProviderOf(resource.data)
      );
      allow list: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        isProviderInCityOf(resource.data)
      );
      allow create: if hasVerifiedPhone()
                    && isValidId(requestId)
                    && incoming().id == requestId
                    && incoming().customerId == request.auth.uid
                    && incoming().city is string && incoming().city.size() <= 50
                    && incoming().category is string && incoming().category.size() <= 100
                    && ('service' in incoming()) && incoming()['service'] is string && incoming()['service'].size() <= 150
                    && incoming().status in ['OPEN', 'NEW', 'MATCHING']
                    // Selection and payment state are never set by the client at creation
                    && !('selectedOfferId' in incoming())
                    && !('paymentStatus' in incoming())
                    && !('escrowAmount' in incoming())
                    && requestFieldLimits(incoming())
                    && (!('attachments' in incoming()) || (incoming().attachments is list && incoming().attachments.size() <= 15))
                    && (!('location' in incoming()) || (incoming().location is map && ('latitude' in incoming().location) && ('longitude' in incoming().location)));
      // Which fields an update changes, computed once: diff() walks the whole document (including the
      // nested understanding map), so repeating it per branch could exceed the 1000-expression limit.
      function requestUpdateAllowed() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return (
        // 1. Customer updating request details while open (allowlist of editable request fields; cannot change id, customerId, status or selectedOfferId)
        (existing().customerId == request.auth.uid &&
         incoming().status == existing().status &&
         incoming().customerId == existing().customerId &&
         incoming().id == existing().id &&
         existing().status in ['OPEN', 'NEW', 'MATCHING', 'OFFERS_RECEIVED'] &&
         ((!('selectedOfferId' in existing()) && !('selectedOfferId' in incoming())) ||
          ('selectedOfferId' in existing() && 'selectedOfferId' in incoming() && incoming().selectedOfferId == existing().selectedOfferId)) &&
         changed.hasOnly([
           'requestText', 'description', 'service', 'category', 'categoryId',
           'city', 'cityId', 'serviceId', 'date', 'budget', 'urgency', 'customerName',
           'attachments', 'location', 'understanding', 'updatedAt'
         ]) &&
         requestFieldLimits(incoming()) &&
         (!('attachments' in incoming()) || (incoming().attachments is list && incoming().attachments.size() <= 15)) &&
         (!('location' in incoming()) || (incoming().location is map && ('latitude' in incoming().location) && ('longitude' in incoming().location)))) ||
        // 2. Customer accepting an offer (transitioning to PROVIDER_SELECTED with verified offer; cannot switch once selected)
        (existing().customerId == request.auth.uid &&
         incoming().customerId == existing().customerId &&
         incoming().id == existing().id &&
         existing().status in ['OPEN', 'NEW', 'MATCHING', 'OFFERS_RECEIVED'] &&
         !('selectedOfferId' in existing()) &&
         incoming().status == 'PROVIDER_SELECTED' &&
         incoming().selectedOfferId is string &&
         exists(/databases/$(database)/documents/offers/$(incoming().selectedOfferId)) &&
         get(/databases/$(database)/documents/offers/$(incoming().selectedOfferId)).data.requestId == requestId &&
         get(/databases/$(database)/documents/offers/$(incoming().selectedOfferId)).data.status in ['PENDING', 'ACCEPTED'] &&
         changed.hasOnly(['status', 'selectedOfferId', 'updatedAt'])) ||
        // 3. Customer cancelling request
        (existing().customerId == request.auth.uid &&
         incoming().customerId == existing().customerId &&
         incoming().id == existing().id &&
         existing().status in ['OPEN', 'NEW', 'MATCHING', 'OFFERS_RECEIVED', 'PROVIDER_SELECTED', 'ACCEPTED', 'IN_PROGRESS'] &&
         incoming().status == 'CANCELLED' &&
         ((!('selectedOfferId' in existing()) && !('selectedOfferId' in incoming())) ||
          ('selectedOfferId' in existing() && 'selectedOfferId' in incoming() && incoming().selectedOfferId == existing().selectedOfferId)) &&
         changed.hasOnly(['status', 'updatedAt'])) ||
        // 4. Provider updating status to OFFERS_RECEIVED when submitting an offer
        (existing().customerId != request.auth.uid &&
         incoming().status == 'OFFERS_RECEIVED' &&
         existing().status in ['OPEN', 'MATCHING', 'NEW', 'OFFERS_RECEIVED'] &&
         incoming().customerId == existing().customerId &&
         incoming().id == existing().id &&
         changed.hasOnly(['status', 'updatedAt', 'lastOfferId', 'offerId']) &&
         (
           ('lastOfferId' in incoming() &&
            incoming().lastOfferId is string &&
            exists(/databases/$(database)/documents/offers/$(incoming().lastOfferId)) &&
            get(/databases/$(database)/documents/offers/$(incoming().lastOfferId)).data.requestId == requestId &&
            (get(/databases/$(database)/documents/offers/$(incoming().lastOfferId)).data.providerUserId == request.auth.uid ||
             get(/databases/$(database)/documents/offers/$(incoming().lastOfferId)).data.providerId == request.auth.uid) &&
            get(/databases/$(database)/documents/offers/$(incoming().lastOfferId)).data.status == 'PENDING')
           ||
           ('offerId' in incoming() &&
            incoming().offerId is string &&
            exists(/databases/$(database)/documents/offers/$(incoming().offerId)) &&
            get(/databases/$(database)/documents/offers/$(incoming().offerId)).data.requestId == requestId &&
            (get(/databases/$(database)/documents/offers/$(incoming().offerId)).data.providerUserId == request.auth.uid ||
             get(/databases/$(database)/documents/offers/$(incoming().offerId)).data.providerId == request.auth.uid) &&
            get(/databases/$(database)/documents/offers/$(incoming().offerId)).data.status == 'PENDING')
         )) ||
        // 5. Selected provider starting the job, or reporting it finished (providerDoneAt).
        //    Only the customer can mark the request COMPLETED (branch 6).
        (existing().status in ['PROVIDER_SELECTED', 'ACCEPTED', 'IN_PROGRESS'] &&
         (incoming().status == existing().status || incoming().status == 'IN_PROGRESS') &&
         changed.hasOnly(['status', 'providerDoneAt', 'updatedAt']) &&
         (!('providerDoneAt' in incoming()) || (incoming().providerDoneAt is string && incoming().providerDoneAt.size() <= 40)) &&
         ('selectedOfferId' in existing()) && existing().selectedOfferId is string &&
         ('selectedOfferId' in incoming()) && incoming().selectedOfferId == existing().selectedOfferId &&
         exists(/databases/$(database)/documents/offers/$(existing().selectedOfferId)) &&
         (get(/databases/$(database)/documents/offers/$(existing().selectedOfferId)).data.providerUserId == request.auth.uid ||
          get(/databases/$(database)/documents/offers/$(existing().selectedOfferId)).data.providerId == request.auth.uid)) ||
        // 6. Customer confirming job completion (transitioning to COMPLETED)
        (existing().customerId == request.auth.uid &&
         incoming().customerId == existing().customerId &&
         incoming().id == existing().id &&
         existing().status in ['PROVIDER_SELECTED', 'ACCEPTED', 'IN_PROGRESS'] &&
         incoming().status == 'COMPLETED' &&
         ('selectedOfferId' in existing()) && existing().selectedOfferId is string &&
         ('selectedOfferId' in incoming()) && incoming().selectedOfferId == existing().selectedOfferId &&
         changed.hasOnly(['status', 'updatedAt']))
        );
      }

      allow update: if isSignedIn() && isValidId(requestId) && requestUpdateAllowed();
      allow delete: if false;
    }

    // Helper: Verify caller is the provider of an accepted offer for the given request
    function isAcceptedOfferProvider(reqId) {
      return exists(/databases/$(database)/documents/requests/$(reqId)) &&
        ('selectedOfferId' in get(/databases/$(database)/documents/requests/$(reqId)).data) &&
        get(/databases/$(database)/documents/requests/$(reqId)).data.selectedOfferId is string &&
        get(/databases/$(database)/documents/requests/$(reqId)).data.selectedOfferId.size() > 0 &&
        exists(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(reqId)).data.selectedOfferId)) &&
        get(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(reqId)).data.selectedOfferId)).data.requestId == reqId &&
        get(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(reqId)).data.selectedOfferId)).data.status == 'ACCEPTED' &&
        (
          get(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(reqId)).data.selectedOfferId)).data.providerUserId == request.auth.uid ||
          get(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(reqId)).data.selectedOfferId)).data.providerId == request.auth.uid
        );
    }

    // =================== Request Contacts Collection ===================
    // Private Contact Info: Customer Phone Number
    // - Only customer and the selected provider (whose offer was accepted) can read customer contact details
    match /requestContacts/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (
        resource.data.customerId == request.auth.uid ||
        isAcceptedOfferProvider(requestId)
      );
      allow list: if false;
      allow create, update: if isSignedIn() && isValidId(requestId) && incoming().customerId == request.auth.uid && exists(/databases/$(database)/documents/requests/$(requestId)) && get(/databases/$(database)/documents/requests/$(requestId)).data.customerId == request.auth.uid;
      // Account deletion: the customer removes their contact details (deleting a missing document is a no-op)
      allow delete: if isSignedIn() && isValidId(requestId) && (resource == null || resource.data.customerId == request.auth.uid);
    }

    // =================== Offers Collection ===================
    // Provider Offers:
    // - Providers can create, update, and list only their own offers (providerUserId == request.auth.uid)
    // - Customers can only read and list offers belonging to requests they own (requests.customerId == request.auth.uid)
    // - Blanket or unconstrained offers queries are strictly forbidden
    match /offers/{offerId} {
      allow get: if isSignedIn() && isValidId(offerId) && (
        resource.data.providerUserId == request.auth.uid ||
        (resource.data.requestId is string &&
         get(/databases/$(database)/documents/requests/$(resource.data.requestId)).data.customerId == request.auth.uid)
      );
      allow list: if isSignedIn() && (
        // Provider querying their own offers (where('providerUserId', '==', request.auth.uid))
        resource.data.providerUserId == request.auth.uid ||
        // Customer querying offers for their own request (where('requestId', '==', filter.requestId))
        (resource.data.requestId is string &&
         get(/databases/$(database)/documents/requests/$(resource.data.requestId)).data.customerId == request.auth.uid)
      );
      allow create: if hasVerifiedPhone()
                    && isValidId(offerId)
                    && incoming().id == offerId
                    && incoming().requestId is string && incoming().requestId.size() <= 64
                    && exists(/databases/$(database)/documents/requests/$(incoming().requestId))
                    && get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.status in ['OPEN', 'NEW', 'MATCHING', 'OFFERS_RECEIVED']
                    && incoming().providerUserId == request.auth.uid
                    // providerId names the provider profile shown to the customer; it must be the caller's own
                    && (!('providerId' in incoming()) || incoming().providerId == request.auth.uid)
                    && incoming().price is string && incoming().price.size() <= 50
                    && incoming().status == 'PENDING'
                    // Payment state is managed by the backend only
                    && !('paymentStatus' in incoming())
                    && noTrustBadges(incoming())
                    && offerFieldLimits(incoming());
      allow update: if isSignedIn() && isValidId(offerId) && (
        // Provider updating their own offer details while still PENDING
        (
          (existing().providerUserId == request.auth.uid || (('providerId' in existing()) && existing().providerId == request.auth.uid)) &&
          incoming().providerUserId == existing().providerUserId &&
          incoming().requestId == existing().requestId &&
          incoming().id == existing().id &&
          (!('providerId' in existing()) || incoming().providerId == existing().providerId) &&
          (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
          existing().status == 'PENDING' &&
          incoming().status == 'PENDING' &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'price', 'priceType', 'availability', 'message',
            'providerPhone', 'providerWhatsapp', 'providerName', 'updatedAt'
          ]) &&
          incoming().price is string && incoming().price.size() <= 50 &&
          offerFieldLimits(incoming())
        ) ||
        // Customer accepting or rejecting an offer (status transition: PENDING -> ACCEPTED / REJECTED)
        // paymentStatus cannot be set or modified by client directly; it is managed exclusively by backend escrow webhook (kaspiEscrowWebhook)
        (
          get(/databases/$(database)/documents/requests/$(existing().requestId)).data.customerId == request.auth.uid &&
          incoming().id == existing().id &&
          incoming().requestId == existing().requestId &&
          incoming().providerUserId == existing().providerUserId &&
          (!('providerId' in existing()) || incoming().providerId == existing().providerId) &&
          (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
          (!('paymentStatus' in incoming()) || (('paymentStatus' in existing()) && incoming().paymentStatus == existing().paymentStatus)) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          existing().status == 'PENDING' &&
          incoming().status in ['ACCEPTED', 'REJECTED']
        )
      );
      allow delete: if false;
    }

    // =================== Reviews Collection ===================
    // Customer Reviews & Ratings for Completed Jobs:
    // - Document ID is strictly bound to requestId (/reviews/{requestId}) to prevent duplicate reviews
    // - Server-side verified against actual completed request & accepted offer
    // - Reviewer must be the customer who created the completed request
    // - Reviewed provider must be the one whose offer was accepted
    // - Provider cannot review themselves
    // - Rating must be an integer from 1 to 5
    // - Updates and deletes are strictly prohibited
    match /reviews/{reviewId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
                    && isValidId(reviewId)
                    && reviewId == incoming().requestId
                    && incoming().id == reviewId
                    && incoming().customerId == request.auth.uid
                    && incoming().providerId is string
                    && incoming().providerId != request.auth.uid
                    && incoming().rating is int && incoming().rating >= 1 && incoming().rating <= 5
                    && exists(/databases/$(database)/documents/requests/$(incoming().requestId))
                    && get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.status == 'COMPLETED'
                    && get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.customerId == request.auth.uid
                    && (get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.selectedOfferId is string)
                    && exists(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.selectedOfferId))
                    && get(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.selectedOfferId)).data.status == 'ACCEPTED'
                    && get(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.selectedOfferId)).data.providerId == incoming().providerId;
      allow update: if false;
      allow delete: if false;
    }

    // =================== Conversations Collection ===================
    // Customer ↔ Selected Provider in-app messaging:
    // - Document ID is strictly deterministic: conv_{requestId}
    // - Only participants (customerId == auth.uid or providerUserId == auth.uid or providerId == auth.uid) can read
    // - Cannot be created or accessed for OPEN requests (request must be in PROVIDER_SELECTED, ACCEPTED, IN_PROGRESS, or COMPLETED)
    // - List queries strictly scoped to current user as participant (preventing blanket discovery)
    match /conversations/{conversationId} {
      allow get: if isSignedIn() && isValidId(conversationId) && (
        resource == null ||
        resource.data.customerId == request.auth.uid ||
        resource.data.providerUserId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.providerUserId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      );
      allow create: if isSignedIn()
                    && isValidId(conversationId)
                    && conversationId == ('conv_' + incoming().requestId)
                    && exists(/databases/$(database)/documents/requests/$(incoming().requestId))
                    && get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.status in ['PROVIDER_SELECTED', 'ACCEPTED', 'IN_PROGRESS', 'COMPLETED']
                    && ('selectedOfferId' in get(/databases/$(database)/documents/requests/$(incoming().requestId)).data)
                    && (get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.selectedOfferId is string)
                    && exists(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.selectedOfferId))
                    && get(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.selectedOfferId)).data.requestId == incoming().requestId
                    && get(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.selectedOfferId)).data.providerUserId == incoming().providerUserId
                    && get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.customerId == incoming().customerId
                    && (incoming().customerId == request.auth.uid || incoming().providerUserId == request.auth.uid)
                    && incoming().status in ['ACTIVE', 'ARCHIVED'];
      allow update: if isSignedIn() && isValidId(conversationId) && (
        (resource.data.customerId == request.auth.uid ||
         resource.data.providerUserId == request.auth.uid ||
         resource.data.providerId == request.auth.uid) &&
        incoming().customerId == existing().customerId &&
        incoming().providerUserId == existing().providerUserId &&
        // providerId also grants access (reads, messages, attachments), so it is immutable too
        incoming().get('providerId', null) == existing().get('providerId', null) &&
        incoming().requestId == existing().requestId &&
        incoming().id == existing().id &&
        strMax(incoming(), 'customerName', 100) && strMax(incoming(), 'providerName', 100) &&
        strMax(incoming(), 'lastMessageText', 2000)
      );
      allow delete: if false;

      // Messages Subcollection
      match /messages/{messageId} {
        allow read: if isSignedIn()
                      && exists(/databases/$(database)/documents/conversations/$(conversationId))
                      && (
                        get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerId == request.auth.uid ||
                        get(/databases/$(database)/documents/conversations/$(conversationId)).data.providerUserId == request.auth.uid ||
                        get(/databases/$(database)/documents/conversations/$(conversationId)).data.providerId == request.auth.uid
                      );
        allow create: if isSignedIn()
                      && isValidId(messageId)
                      && incoming().id == messageId
                      && incoming().conversationId == conversationId
                      && incoming().senderId == request.auth.uid
                      && incoming().type in ['text', 'image', 'file']
                      && incoming().text is string && incoming().text.size() <= 2000
                      && (!('attachments' in incoming()) || (incoming().attachments is list && incoming().attachments.size() <= 10))
                      && conversationId == ('conv_' + incoming().requestId)
                      && exists(/databases/$(database)/documents/conversations/$(conversationId))
                      && get(/databases/$(database)/documents/conversations/$(conversationId)).data.requestId == incoming().requestId
                      && (
                        (get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerId == request.auth.uid && incoming().senderRole == 'customer') ||
                        ((get(/databases/$(database)/documents/conversations/$(conversationId)).data.providerUserId == request.auth.uid || get(/databases/$(database)/documents/conversations/$(conversationId)).data.providerId == request.auth.uid) && incoming().senderRole == 'provider')
                      )
                      && exists(/databases/$(database)/documents/requests/$(incoming().requestId))
                      && get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.status in ['PROVIDER_SELECTED', 'ACCEPTED', 'IN_PROGRESS', 'COMPLETED']
                      && get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.status != 'CANCELLED'
                      && get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.status != 'OPEN';
        allow update: if false;
        allow delete: if false;
      }
    }

    // =================== Notifications Collection ===================
    // Each related document is read once through these helpers (missing documents read as an empty
    // map), which keeps the create rule well under the 1000-expression evaluation limit.
    function offerOrEmpty(offerId) {
      return exists(/databases/$(database)/documents/offers/$(offerId))
        ? get(/databases/$(database)/documents/offers/$(offerId)).data : {};
    }

    function conversationOrEmpty(conversationId) {
      return exists(/databases/$(database)/documents/conversations/$(conversationId))
        ? get(/databases/$(database)/documents/conversations/$(conversationId)).data : {};
    }

    function appointmentOrEmpty(requestId) {
      return exists(/databases/$(database)/documents/appointments/$('appointment_' + requestId))
        ? get(/databases/$(database)/documents/appointments/$('appointment_' + requestId)).data : {};
    }

    // True when uid is the provider on an offer, conversation or appointment document
    function isProviderOn(d, uid) {
      return d.get('providerUserId', '') == uid || d.get('providerId', '') == uid;
    }

    // Is uid the provider working on this request: the selected offer, the offer named in the
    // notification, the request's conversation, or its appointment
    function isProviderOfRequest(n, req, uid) {
      return (req.get('selectedOfferId', '') is string && req.get('selectedOfferId', '') != ''
              && isProviderOn(offerOrEmpty(req.get('selectedOfferId', '')), uid))
        || (('offerId' in n) && isProviderOn(offerOrEmpty(n.offerId), uid))
        || (('conversationId' in n)
            && conversationOrEmpty(n.conversationId).get('requestId', '') == n.requestId
            && conversationOrEmpty(n.conversationId).get('customerId', '') == req.customerId
            && isProviderOn(conversationOrEmpty(n.conversationId), uid))
        || (appointmentOrEmpty(n.requestId).get('customerId', '') == req.customerId
            && isProviderOn(appointmentOrEmpty(n.requestId), uid));
    }

    function notificationSenderAllowed(n, req) {
      let uid = request.auth.uid;
      return (
        // 1. The customer confirming something to themselves (offer accepted, completion, review prompt)
        (n.recipientUserId == uid && n.recipientRole == 'customer' && req.customerId == uid
          && n.type in ['CUSTOMER_OFFER_ACCEPTED', 'CUSTOMER_WORK_COMPLETED', 'CUSTOMER_REVIEW_REQUIRED'])
        // 2. The customer notifying a provider who works on, or offered for, this request
        || (req.customerId == uid && n.recipientRole == 'provider' && n.recipientUserId != uid
          && isProviderOfRequest(n, req, n.recipientUserId))
        // 3. A provider of this request notifying its customer
        || (n.recipientUserId == req.customerId && n.recipientRole == 'customer' && n.recipientUserId != uid
          && isProviderOfRequest(n, req, uid))
      );
    }

    // Spark MVP In-App Notification System:
    // - Document ID is deterministic/idempotent: notif_{type}_{refId}
    // - Reading & listing is strictly scoped to the recipient (recipientUserId == request.auth.uid)
    // - Creating a notification requires authentication, valid document structure, unread status,
    //   and verified request context (no unconstrained self-creation and no arbitrary writes):
    //   1. Self-notification: only the customer who owns the request can notify themselves for valid completion/review/accept flows
    //   2. Customer -> Provider: recipient must be verified via selectedOfferId, valid offer, conversation, or appointment
    //   3. Provider -> Customer: caller must be verified via offer, selectedOfferId, conversation, or appointment, and recipient must be request's customer
    // - Updating is strictly restricted to marking as read (isRead, readAt, updatedAt) by the recipient
    //   with verified data types (isRead must be bool, timestamps ISO strings/null) while core identity remains completely immutable
    // - Deletion is strictly prohibited
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && resource.data.recipientUserId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.recipientUserId == request.auth.uid;

      allow create: if isSignedIn()
                    && isValidId(notificationId)
                    && incoming().id == notificationId
                    && incoming().recipientUserId is string && isValidId(incoming().recipientUserId)
                    && incoming().recipientRole in ['customer', 'provider']
                    && incoming().type in [
                      'NEW_REQUEST', 'CUSTOMER_NEW_OFFER', 'CUSTOMER_OFFER_ACCEPTED', 'CUSTOMER_NEW_MESSAGE',
                      'CUSTOMER_NEW_ATTACHMENT', 'CUSTOMER_WORK_COMPLETED', 'CUSTOMER_REVIEW_REQUIRED',
                      'CUSTOMER_APPOINTMENT_CREATED', 'CUSTOMER_APPOINTMENT_UPDATED', 'CUSTOMER_APPOINTMENT_CANCELLED',
                      'CUSTOMER_PROVIDER_ON_THE_WAY', 'CUSTOMER_PROVIDER_ARRIVED', 'CUSTOMER_WORK_STARTED',
                      'PROVIDER_WORK_STATUS_UPDATED', 'PROVIDER_OFFER_ACCEPTED', 'PROVIDER_NEW_MESSAGE',
                      'PROVIDER_NEW_ATTACHMENT', 'PROVIDER_REQUEST_CANCELLED', 'PROVIDER_WORK_COMPLETED',
                      'PROVIDER_APPOINTMENT_CREATED', 'PROVIDER_APPOINTMENT_UPDATED', 'PROVIDER_APPOINTMENT_CANCELLED'
                    ]
                    && incoming().isRead == false
                    && (!('readAt' in incoming()) || incoming().readAt == null)
                    && incoming().createdAt is string && incoming().createdAt.size() >= 10 && incoming().createdAt.size() <= 40
                    && incoming().targetScreen in ['request_detail', 'request_details', 'chat', 'offers_list', 'review_modal']
                    && ('requestId' in incoming()) && incoming().requestId is string && isValidId(incoming().requestId)
                    && exists(/databases/$(database)/documents/requests/$(incoming().requestId))
                    && (!('offerId' in incoming()) || (incoming().offerId is string && isValidId(incoming().offerId)
                        && offerOrEmpty(incoming().offerId).get('requestId', '') == incoming().requestId))
                    && (!('conversationId' in incoming()) || (incoming().conversationId is string && isValidId(incoming().conversationId)))
                    && notificationSenderAllowed(incoming(), get(/databases/$(database)/documents/requests/$(incoming().requestId)).data);

      allow update: if isSignedIn()
                    && isValidId(notificationId)
                    && resource.data.recipientUserId == request.auth.uid
                    && incoming().id == resource.data.id
                    && incoming().recipientUserId == resource.data.recipientUserId
                    && incoming().recipientRole == resource.data.recipientRole
                    && incoming().type == resource.data.type
                    && incoming().createdAt == resource.data.createdAt
                    && incoming().isRead is bool
                    && (!('readAt' in incoming()) || incoming().readAt == null || (incoming().readAt is string && incoming().readAt.size() >= 10 && incoming().readAt.size() <= 40))
                    && (!('updatedAt' in incoming()) || (incoming().updatedAt is string && incoming().updatedAt.size() >= 10 && incoming().updatedAt.size() <= 40))
                    && incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'readAt', 'updatedAt']);

      allow delete: if false;
    }

    // =================== Appointments Collection ===================
    // Service Appointments / Scheduling:
    // - Deterministic ID: appointment_{requestId}
    // - Only customer and accepted provider of the request can read, create, and update
    // - Cannot create appointment for CANCELLED requests or requests without accepted/selected provider
    // - Safe optional field checks for durationMinutes and note
    // - Valid status transitions enforced:
    //     PROPOSED -> CONFIRMED, RESCHEDULED, CANCELLED
    //     CONFIRMED -> RESCHEDULED, CANCELLED, COMPLETED
    //     RESCHEDULED -> CONFIRMED, RESCHEDULED, CANCELLED
    // - Immutable keys: id, requestId, customerId, providerId, providerUserId, createdAt
    match /appointments/{appointmentId} {
      allow get: if isSignedIn() && isValidId(appointmentId) && (
        resource == null ||
        resource.data.customerId == request.auth.uid ||
        resource.data.providerUserId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.providerUserId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      );

      allow create: if isSignedIn()
                    && isValidId(appointmentId)
                    && appointmentId == ('appointment_' + incoming().requestId)
                    && incoming().id == appointmentId
                    && incoming().proposedBy in ['customer', 'provider']
                    && exists(/databases/$(database)/documents/requests/$(incoming().requestId))
                    && get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.status in ['PROVIDER_SELECTED', 'ACCEPTED', 'IN_PROGRESS']
                    && ('selectedOfferId' in get(/databases/$(database)/documents/requests/$(incoming().requestId)).data)
                    && (get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.selectedOfferId is string)
                    && get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.customerId == incoming().customerId
                    && exists(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.selectedOfferId))
                    && get(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.selectedOfferId)).data.requestId == incoming().requestId
                    && get(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.selectedOfferId)).data.status == 'ACCEPTED'
                    && (
                      incoming().providerId == get(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.selectedOfferId)).data.providerId ||
                      incoming().providerId == get(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.selectedOfferId)).data.providerUserId
                    )
                    && (
                      incoming().providerUserId == get(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.selectedOfferId)).data.providerUserId ||
                      incoming().providerUserId == get(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.selectedOfferId)).data.providerId
                    )
                    && (
                      (
                        incoming().proposedBy == 'customer'
                        && request.auth.uid == incoming().customerId
                        && request.auth.uid == get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.customerId
                      ) ||
                      (
                        incoming().proposedBy == 'provider'
                        && (request.auth.uid == incoming().providerUserId || request.auth.uid == incoming().providerId)
                        && (
                          request.auth.uid == get(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.selectedOfferId)).data.providerUserId ||
                          request.auth.uid == get(/databases/$(database)/documents/offers/$(get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.selectedOfferId)).data.providerId
                        )
                      )
                    )
                    && incoming().status in ['PROPOSED', 'CONFIRMED']
                    && incoming().scheduledAt is string && incoming().scheduledAt.size() >= 10 && incoming().scheduledAt.size() <= 40
                    && (!('durationMinutes' in incoming()) || (incoming().durationMinutes is number && incoming().durationMinutes > 0 && incoming().durationMinutes <= 1440))
                    && (!('note' in incoming()) || (incoming().note is string && incoming().note.size() <= 1000))
                    && (!('workStatus' in incoming()) || incoming().workStatus in ['NOT_STARTED', 'PROVIDER_ON_THE_WAY', 'PROVIDER_ARRIVED', 'WORK_STARTED', 'WORK_COMPLETED', 'CANCELLED'])
                    && (!('workStatusUpdatedAt' in incoming()) || incoming().workStatusUpdatedAt is string)
                    && incoming().createdAt is string
                    && incoming().updatedAt is string;

      allow update: if isSignedIn()
                    && isValidId(appointmentId)
                    && (
                      resource.data.customerId == request.auth.uid ||
                      resource.data.providerUserId == request.auth.uid ||
                      resource.data.providerId == request.auth.uid
                    )
                    && incoming().id == resource.data.id
                    && incoming().requestId == resource.data.requestId
                    && incoming().customerId == resource.data.customerId
                    && incoming().providerId == resource.data.providerId
                    && incoming().providerUserId == resource.data.providerUserId
                    && incoming().createdAt == resource.data.createdAt
                    && incoming().diff(resource.data).affectedKeys().hasOnly([
                      'status', 'scheduledAt', 'durationMinutes', 'note', 'proposedBy',
                      'workStatus', 'workStatusUpdatedAt', 'updatedAt'
                    ])
                    && (
                      incoming().proposedBy == resource.data.proposedBy ||
                      (incoming().proposedBy == 'customer' && request.auth.uid == resource.data.customerId) ||
                      (incoming().proposedBy == 'provider' && (request.auth.uid == resource.data.providerUserId || request.auth.uid == resource.data.providerId))
                    )
                    && incoming().updatedAt is string
                    && incoming().scheduledAt is string && incoming().scheduledAt.size() >= 10 && incoming().scheduledAt.size() <= 40
                    && (!('durationMinutes' in incoming()) || (incoming().durationMinutes is number && incoming().durationMinutes > 0 && incoming().durationMinutes <= 1440))
                    && (!('note' in incoming()) || (incoming().note is string && incoming().note.size() <= 1000))
                    && exists(/databases/$(database)/documents/requests/$(resource.data.requestId))
                    && get(/databases/$(database)/documents/requests/$(resource.data.requestId)).data.status != 'COMPLETED'
                    && (
                      (resource.data.status == 'PROPOSED' && incoming().status in ['PROPOSED', 'CONFIRMED', 'RESCHEDULED', 'CANCELLED']) ||
                      (resource.data.status == 'CONFIRMED' && incoming().status in ['CONFIRMED', 'RESCHEDULED', 'CANCELLED', 'COMPLETED']) ||
                      (resource.data.status == 'RESCHEDULED' && incoming().status in ['RESCHEDULED', 'CONFIRMED', 'CANCELLED']) ||
                      (resource.data.status == 'COMPLETED' && incoming().status == 'COMPLETED') ||
                      (resource.data.status == 'CANCELLED' && incoming().status == 'CANCELLED')
                    )
                    && (
                      (!('workStatus' in incoming()) && !('workStatus' in resource.data)) ||
                      (('workStatus' in incoming()) && ('workStatus' in resource.data) && incoming().workStatus == resource.data.workStatus) ||
                      (
                        (request.auth.uid == resource.data.providerUserId || request.auth.uid == resource.data.providerId)
                        && ('workStatus' in incoming())
                        && (
                          ((!('workStatus' in resource.data) || resource.data.workStatus == 'NOT_STARTED') && incoming().workStatus in ['NOT_STARTED', 'PROVIDER_ON_THE_WAY', 'CANCELLED']) ||
                          (resource.data.workStatus == 'PROVIDER_ON_THE_WAY' && incoming().workStatus in ['PROVIDER_ON_THE_WAY', 'PROVIDER_ARRIVED', 'CANCELLED']) ||
                          (resource.data.workStatus == 'PROVIDER_ARRIVED' && incoming().workStatus in ['PROVIDER_ARRIVED', 'WORK_STARTED', 'CANCELLED']) ||
                          (resource.data.workStatus == 'WORK_STARTED' && incoming().workStatus in ['WORK_STARTED', 'WORK_COMPLETED', 'CANCELLED'])
                        )
                      ) ||
                      (
                        request.auth.uid == resource.data.customerId
                        && incoming().status == 'COMPLETED'
                        && ('workStatus' in incoming())
                        && incoming().workStatus == 'WORK_COMPLETED'
                        && resource.data.status in ['CONFIRMED', 'COMPLETED']
                      )
                    )
                    && (!('workStatusUpdatedAt' in incoming()) || incoming().workStatusUpdatedAt is string);

      allow delete: if false;
    }
  }
}
