{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered customer or provider in the KEREK marketplace",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user identifier",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "enum": ["customer", "provider", "both"],
          "description": "Role of the user in marketplace"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "createdAt"]
    },
    "Provider": {
      "title": "Provider",
      "description": "Public and verified service provider profile",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "whatsapp": {
          "type": "string",
          "maxLength": 30
        },
        "city": {
          "type": "string",
          "maxLength": 50
        },
        "district": {
          "type": "string",
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "maxLength": 100
        },
        "services": {
          "type": "string",
          "maxLength": 500
        },
        "priceRange": {
          "type": "string",
          "maxLength": 50
        },
        "workingHours": {
          "type": "string",
          "maxLength": 50
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "availability": {
          "type": "string",
          "maxLength": 100
        },
        "verified": {
          "type": "boolean"
        },
        "isDemo": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "phone", "city", "category"]
    },
    "ServiceRequest": {
      "title": "ServiceRequest",
      "description": "Customer request for a service or goods in Kazakhstan",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "customerId": {
          "type": "string",
          "maxLength": 128
        },
        "customerName": {
          "type": "string",
          "maxLength": 100
        },
        "customerPhone": {
          "type": "string",
          "maxLength": 30
        },
        "requestText": {
          "type": "string",
          "maxLength": 1000
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "city": {
          "type": "string",
          "maxLength": 50
        },
        "category": {
          "type": "string",
          "maxLength": 100
        },
        "service": {
          "type": "string",
          "maxLength": 150
        },
        "date": {
          "type": "string",
          "maxLength": 50
        },
        "budget": {
          "type": "string",
          "maxLength": 50
        },
        "urgency": {
          "type": "string",
          "enum": ["high", "normal", "low"]
        },
        "status": {
          "type": "string",
          "enum": ["OPEN", "PROVIDER_SELECTED", "IN_PROGRESS", "COMPLETED", "CANCELLED", "NEW", "MATCHING", "OFFERS_RECEIVED", "ACCEPTED", "REJECTED"]
        },
        "selectedOfferId": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "customerId", "city", "category", "service", "status"]
    },
    "ProviderOffer": {
      "title": "ProviderOffer",
      "description": "Price, availability, and message offer submitted by a provider",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "requestId": {
          "type": "string",
          "maxLength": 64
        },
        "providerId": {
          "type": "string",
          "maxLength": 128
        },
        "providerUserId": {
          "type": "string",
          "maxLength": 128
        },
        "providerName": {
          "type": "string",
          "maxLength": 100
        },
        "providerPhone": {
          "type": "string",
          "maxLength": 30
        },
        "providerWhatsapp": {
          "type": "string",
          "maxLength": 30
        },
        "price": {
          "type": "string",
          "maxLength": 50
        },
        "availability": {
          "type": "string",
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": ["PENDING", "ACCEPTED", "REJECTED"]
        },
        "isDemo": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "requestId", "providerId", "price", "availability", "status"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer ratings and feedback for completed jobs",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "requestId": {
          "type": "string",
          "maxLength": 64
        },
        "customerId": {
          "type": "string",
          "maxLength": 128
        },
        "customerName": {
          "type": "string",
          "maxLength": 100
        },
        "providerId": {
          "type": "string",
          "maxLength": 128
        },
        "providerName": {
          "type": "string",
          "maxLength": 100
        },
        "rating": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "comment": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "requestId", "customerId", "providerId", "rating", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile documents keyed by userId"
    },
    "/providers/{providerId}": {
      "schema": { "$ref": "#/entities/Provider" },
      "description": "Provider profile documents keyed by providerId"
    },
    "/requests/{requestId}": {
      "schema": { "$ref": "#/entities/ServiceRequest" },
      "description": "Service request documents keyed by requestId"
    },
    "/offers/{offerId}": {
      "schema": { "$ref": "#/entities/ProviderOffer" },
      "description": "Provider offers keyed by offerId"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Customer reviews keyed by requestId"
    }
  }
}
