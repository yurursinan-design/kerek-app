{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered customer or provider in the KEREK marketplace",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user identifier",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "enum": ["customer", "provider", "both"],
          "description": "Role of the user in marketplace"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "createdAt"]
    },
    "Provider": {
      "title": "Provider",
      "description": "Public and verified service provider profile",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "whatsapp": {
          "type": "string",
          "maxLength": 30
        },
        "city": {
          "type": "string",
          "maxLength": 50
        },
        "district": {
          "type": "string",
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "maxLength": 100
        },
        "services": {
          "type": "string",
          "maxLength": 500
        },
        "priceRange": {
          "type": "string",
          "maxLength": 50
        },
        "workingHours": {
          "type": "string",
          "maxLength": 50
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "availability": {
          "type": "string",
          "maxLength": 100
        },
        "verified": {
          "type": "boolean"
        },
        "isDemo": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "phone", "city", "category"]
    },
    "ServiceRequest": {
      "title": "ServiceRequest",
      "description": "Customer request for a service or goods in Kazakhstan",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "customerId": {
          "type": "string",
          "maxLength": 128
        },
        "customerName": {
          "type": "string",
          "maxLength": 100
        },
        "customerPhone": {
          "type": "string",
          "maxLength": 30
        },
        "requestText": {
          "type": "string",
          "maxLength": 1000
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "city": {
          "type": "string",
          "maxLength": 50
        },
        "category": {
          "type": "string",
          "maxLength": 100
        },
        "service": {
          "type": "string",
          "maxLength": 150
        },
        "date": {
          "type": "string",
          "maxLength": 50
        },
        "budget": {
          "type": "string",
          "maxLength": 50
        },
        "urgency": {
          "type": "string",
          "enum": ["high", "normal", "low"]
        },
        "status": {
          "type": "string",
          "enum": ["OPEN", "PROVIDER_SELECTED", "IN_PROGRESS", "COMPLETED", "CANCELLED", "NEW", "MATCHING", "OFFERS_RECEIVED", "ACCEPTED", "REJECTED"]
        },
        "selectedOfferId": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "customerId", "city", "category", "service", "status"]
    },
    "ProviderOffer": {
      "title": "ProviderOffer",
      "description": "Price, availability, and message offer submitted by a provider",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "requestId": {
          "type": "string",
          "maxLength": 64
        },
        "providerId": {
          "type": "string",
          "maxLength": 128
        },
        "providerUserId": {
          "type": "string",
          "maxLength": 128
        },
        "providerName": {
          "type": "string",
          "maxLength": 100
        },
        "providerPhone": {
          "type": "string",
          "maxLength": 30
        },
        "providerWhatsapp": {
          "type": "string",
          "maxLength": 30
        },
        "price": {
          "type": "string",
          "maxLength": 50
        },
        "availability": {
          "type": "string",
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": ["PENDING", "ACCEPTED", "REJECTED"]
        },
        "isDemo": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "requestId", "providerId", "price", "availability", "status"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer ratings and feedback for completed jobs",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "requestId": {
          "type": "string",
          "maxLength": 64
        },
        "customerId": {
          "type": "string",
          "maxLength": 128
        },
        "customerName": {
          "type": "string",
          "maxLength": 100
        },
        "providerId": {
          "type": "string",
          "maxLength": 128
        },
        "providerName": {
          "type": "string",
          "maxLength": 100
        },
        "rating": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "comment": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "requestId", "customerId", "providerId", "rating", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Customer and provider in-app conversation metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "requestId": { "type": "string", "maxLength": 64 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "providerId": { "type": "string", "maxLength": 128 },
        "providerUserId": { "type": "string", "maxLength": 128 },
        "providerName": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["ACTIVE", "ARCHIVED"] },
        "lastMessageText": { "type": "string", "maxLength": 2000 },
        "lastMessageSenderId": { "type": "string", "maxLength": 128 },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "unreadCountCustomer": { "type": "integer" },
        "unreadCountProvider": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "requestId", "customerId", "providerId", "status", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "In-app message sent between customer and provider",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "requestId": { "type": "string", "maxLength": 64 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderRole": { "type": "string", "enum": ["customer", "provider", "system"] },
        "type": { "type": "string", "enum": ["text", "system"] },
        "text": { "type": "string", "maxLength": 2000 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "conversationId", "requestId", "senderId", "senderRole", "type", "text", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notifications for customer and provider events",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "recipientUserId": { "type": "string", "maxLength": 128 },
        "recipientRole": { "type": "string", "enum": ["customer", "provider"] },
        "type": { "type": "string", "maxLength": 64 },
        "title": { "type": "object" },
        "body": { "type": "object" },
        "requestId": { "type": "string", "maxLength": 64 },
        "offerId": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "providerId": { "type": "string", "maxLength": 128 },
        "targetScreen": { "type": "string", "maxLength": 64 },
        "isRead": { "type": "boolean" },
        "readAt": { "type": ["string", "null"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "recipientUserId", "recipientRole", "type", "isRead", "createdAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Scheduled service appointment between customer and provider",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "requestId": { "type": "string", "maxLength": 64 },
        "customerId": { "type": "string", "maxLength": 128 },
        "providerId": { "type": "string", "maxLength": 128 },
        "providerUserId": { "type": "string", "maxLength": 128 },
        "proposedBy": { "type": "string", "enum": ["customer", "provider"] },
        "scheduledAt": { "type": "string", "maxLength": 40 },
        "durationMinutes": { "type": "number", "minimum": 1, "maximum": 1440 },
        "status": { "type": "string", "enum": ["PROPOSED", "CONFIRMED", "RESCHEDULED", "CANCELLED", "COMPLETED"] },
        "note": { "type": "string", "maxLength": 1000 },
        "workStatus": { "type": "string", "enum": ["NOT_STARTED", "PROVIDER_ON_THE_WAY", "PROVIDER_ARRIVED", "WORK_STARTED", "WORK_COMPLETED", "CANCELLED"] },
        "workStatusUpdatedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "requestId", "customerId", "providerId", "providerUserId", "proposedBy", "scheduledAt", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile documents keyed by userId"
    },
    "/providers/{providerId}": {
      "schema": { "$ref": "#/entities/Provider" },
      "description": "Provider profile documents keyed by providerId"
    },
    "/requests/{requestId}": {
      "schema": { "$ref": "#/entities/ServiceRequest" },
      "description": "Service request documents keyed by requestId"
    },
    "/offers/{offerId}": {
      "schema": { "$ref": "#/entities/ProviderOffer" },
      "description": "Provider offers keyed by offerId"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Customer reviews keyed by requestId"
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Conversation metadata between customer and selected provider"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages subcollection in conversation"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "In-app notifications for users"
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Scheduled appointments between customer and provider"
    }
  }
}
