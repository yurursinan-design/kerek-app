<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing of the app is copied to Google Drive backups or to a new phone: its storage holds the
  sign-in session and cached personal data (requests, chats), and a copy could sign someone else in.
  After moving to a new phone the user signs in again with their number.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
