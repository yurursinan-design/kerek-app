# Non-secret settings for the Kazakhstan copy (kzMirror.ts); the keys are in Secret Manager
KZ_STORAGE_BUCKET=kerek-kz-data
KZ_STORAGE_ENDPOINT=https://storage.yandexcloud.kz
KZ_STORAGE_REGION=kz1
# WhatsApp login (whatsappLogin.ts). The deploy needs every setting written here, even an empty
# one: the business number's id comes from Meta and stays empty until then (codes are not sent)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=tapsyr_login_code
WHATSAPP_GRAPH_VERSION=v23.0
